node_modules/
dist/
.wrangler/
# Local D1 persistence (wrangler --persist-to=.wrangler-shared) — holds the
# local SQLite DB incl. encrypted integration credentials. Never commit.
.wrangler-shared/
.dev.vars
.env.certification.local
# Astro content-collection types cache (apps/web). Regenerated on
# `astro check` / `astro build`; not part of source.
.astro/

# pnpm
pnpm-debug.log*

# Build artifacts
apps/agent/build-*
wrangler.deploy.jsonc
# Per-lane wrangler configs generated by scripts/lane-generate.mjs.
# Ephemeral — regenerate per deploy from the up-to-date prod config.
apps/*/wrangler.lane-*.jsonc
**/tsconfig.tsbuildinfo

# Test
.act.secrets
.act.vars
test-results/
test-heatmap.html
test/eval/data/
# Coverage output (vitest --coverage HTML/JSON/clover)
coverage/
# Certification reports are local evidence and may contain
# provider diagnostics even after redaction.
artifacts/certification/

# RL training artifacts
rl/output/
rl/tasks/terminal-bench/results/
rl/tasks/terminal-bench/tb-source/
rl/tasks/terminal-bench/findings-*.md

# Internal docs (screenshots, design notes, TODOs)
.docs/

# Local-only CLI creds for hitting deployed envs (oma_… user-scoped keys for staging/prod)
.oma-cli.*

# IDE
.vscode/
.idea/
.qoder/
*.swp
.DS_Store
.claude/worktrees/
.claude/scheduled_tasks.lock

# pnpm content store (created when --store-dir=. is used locally)
.pnpm-store/
data/
.env
