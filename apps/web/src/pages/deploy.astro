---
import Base from "../layouts/Base.astro";
import {
  buildDeploymentPlan,
  DEPLOYMENT_TARGETS,
  type DeploymentTarget,
} from "../lib/deploy-wizard";

const targetOrder: DeploymentTarget[] = ["cloudflare", "docker", "fly", "vercel"];
const initialPlan = buildDeploymentPlan({
  target: "cloudflare",
  modelSetup: "console",
  dataMode: "managed",
});
---

<Base
  title="Deploy OpenMA | OpenMA"
  description="Choose an OpenMA topology, review its requirements, and leave with an executable deployment plan for Cloudflare, Docker, Fly.io, or Vercel."
  canonical="/deploy/"
  keywords="deploy OpenMA, self host AI agents, Cloudflare Workers agent platform, Docker agent platform"
>
  <div class="deploy-page" data-deploy-wizard>
    <header class="deploy-intro">
      <div>
        <p class="deploy-kicker">Self-hosting configurator</p>
        <h1>Deploy OpenMA</h1>
        <p class="deploy-lede">
          Pick the runtime boundary. We will turn it into a reviewed topology,
          an executable handoff, and a concrete health check.
        </p>
      </div>
      <div class="privacy-note" role="note">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.8 6.5 9.8 3.8-2 6.5-5.7 6.5-9.8V6L12 3Z"></path>
          <path d="m9.2 12 1.8 1.8 3.9-4"></path>
        </svg>
        <span><strong>Secrets never leave your machine.</strong> Choices stay in this tab; secret values go directly to the provider.</span>
      </div>
    </header>

    <nav class="step-track" aria-label="Deployment progress">
      <button type="button" class="step-item is-active" data-step-jump="1" aria-current="step">
        <span>1</span><span>Platform</span>
      </button>
      <span class="step-line" aria-hidden="true"></span>
      <button type="button" class="step-item" data-step-jump="2" disabled>
        <span>2</span><span>Configure</span>
      </button>
      <span class="step-line" aria-hidden="true"></span>
      <button type="button" class="step-item" data-step-jump="3" disabled>
        <span>3</span><span>Launch</span>
      </button>
    </nav>

    <div class="wizard-shell">
      <section class="wizard-card" aria-live="polite">
        <div class="wizard-panel" data-step-panel="1">
          <div class="panel-heading">
            <div>
              <p class="panel-eyebrow">Step 1 of 3</p>
              <h2>Where should the control plane live?</h2>
              <p>Choose the deployment target. Sandbox providers can still be swapped later.</p>
            </div>
          </div>

          <fieldset class="target-grid">
            <legend class="sr-only">Deployment platform</legend>
            {targetOrder.map((id) => {
              const target = DEPLOYMENT_TARGETS[id];
              return (
                <label class:list={["target-card", id === "cloudflare" && "is-selected"]} data-target-card={id}>
                  <input
                    class="sr-only"
                    type="radio"
                    name="deployment-target"
                    value={id}
                    checked={id === "cloudflare"}
                  />
                  <span class="target-icon" aria-hidden="true">
                    {id === "cloudflare" && (
                      <svg viewBox="0 0 24 24"><path d="M8.2 16.8h10.1a3.2 3.2 0 0 0 .3-6.4A5.6 5.6 0 0 0 8 9.2a4 4 0 0 0 .2 7.6Z"></path><path d="M3.5 16.8h2.2"></path></svg>
                    )}
                    {id === "docker" && (
                      <svg viewBox="0 0 24 24"><path d="M3 13h17c0 4.5-3.2 7-7.7 7H8.5C5.5 20 3 17.5 3 13Z"></path><path d="M7 10h3v3H7zM10 7h3v3h-3zM10 10h3v3h-3zM13 10h3v3h-3zM17.5 11.5c.5-1.5 1.4-2.2 2.5-2.5"></path></svg>
                    )}
                    {id === "fly" && (
                      <svg viewBox="0 0 24 24"><path d="M5 17.5 18.5 4l1.5 1.5L14.5 20l-3-5.5L5 17.5Z"></path><path d="m11.5 14.5 2-2"></path></svg>
                    )}
                    {id === "vercel" && (
                      <svg viewBox="0 0 24 24"><path d="m12 4 9 16H3L12 4Z"></path></svg>
                    )}
                  </span>
                  <span class="target-copy">
                    <span class="target-title-row">
                      <strong>{target.name}</strong>
                      <span class:list={["availability", `is-${target.availability}`]}>{target.eyebrow}</span>
                    </span>
                    <span class="target-summary">{target.summary}</span>
                    <span class="target-note">{target.note}</span>
                  </span>
                  <span class="target-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m7 12 3 3 7-7"></path></svg>
                  </span>
                </label>
              );
            })}
          </fieldset>
        </div>

        <div class="wizard-panel" data-step-panel="2" hidden>
          <div class="panel-heading">
            <div>
              <p class="panel-eyebrow">Step 2 of 3</p>
              <h2>Choose safe defaults</h2>
              <p>These choices only shape your plan. No secret values are requested or transmitted.</p>
            </div>
          </div>

          <fieldset class="choice-section">
            <legend>Model credentials</legend>
            <label class="choice-row is-selected" data-choice-row>
              <input class="sr-only" type="radio" name="model-setup" value="console" checked />
              <span class="radio-dot" aria-hidden="true"></span>
              <span><strong>Configure in Console</strong><small>Add a tenant-scoped Model Card after the deployment is healthy.</small></span>
              <span class="recommendation">Recommended</span>
            </label>
            <label class="choice-row" data-choice-row>
              <input class="sr-only" type="radio" name="model-setup" value="environment" />
              <span class="radio-dot" aria-hidden="true"></span>
              <span><strong>Environment fallback</strong><small>Set a provider key directly in the deployment environment.</small></span>
            </label>
          </fieldset>

          <fieldset class="choice-section" data-data-mode-section hidden>
            <legend>State database</legend>
            <div class="segmented-control">
              <label class="is-selected" data-segment>
                <input class="sr-only" type="radio" name="data-mode" value="sqlite" checked />
                <span>SQLite</span>
              </label>
              <label data-segment>
                <input class="sr-only" type="radio" name="data-mode" value="postgres" />
                <span>Postgres</span>
              </label>
            </div>
            <p class="field-hint" data-data-mode-hint>Best for one durable host. The data directory must be persistent.</p>
          </fieldset>

          <div class="boundary-callout" data-platform-boundary>
            <span class="boundary-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 8v4M12 16h.01"></path><circle cx="12" cy="12" r="9"></circle></svg>
            </span>
            <div><strong>Provider-managed state</strong><p>Cloudflare provisions D1, R2, KV, Queue, Durable Objects, and Containers in your account.</p></div>
          </div>
        </div>

        <div class="wizard-panel" data-step-panel="3" hidden>
          <div class="panel-heading launch-heading">
            <div>
              <p class="panel-eyebrow">Step 3 of 3</p>
              <h2>Your deployment handoff</h2>
              <p data-launch-description>Run this locally. The CLI opens provider authentication and reports each resource it creates.</p>
            </div>
            <span class="launch-status" data-launch-status>{initialPlan.status}</span>
          </div>

          <section class="deployment-return" data-vercel-callback hidden aria-live="polite">
            <span class="deployment-return-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m7 12 3 3 7-7"></path><circle cx="12" cy="12" r="9"></circle></svg>
            </span>
            <div>
              <p class="deployment-return-kicker">Vercel returned successfully</p>
              <h3 data-vercel-project-name>OpenMA project created</h3>
              <p>The control plane is deployed. Next, open it to verify health, then configure its Environment and Sandbox credentials.</p>
              <div class="deployment-return-actions">
                <a data-vercel-deployment-link target="_blank" rel="noopener noreferrer">Open deployment</a>
                <a data-vercel-dashboard-link target="_blank" rel="noopener noreferrer">View in Vercel</a>
              </div>
            </div>
          </section>

          <section class="provider-launch" data-provider-launch hidden>
            <div>
              <strong>Deploy the control plane</strong>
              <p>Vercel clones the repository, provisions Neon Postgres, and collects the remaining values directly. You return here after deployment to finish Sandbox setup.</p>
            </div>
            <a class="vercel-deploy-button" data-vercel-deploy target="_blank" rel="noopener noreferrer">
              Deploy with Vercel
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 4 8 15H4l8-15Z"></path></svg>
            </a>
          </section>

          <div class="command-block">
            <div class="command-toolbar">
              <span data-command-label>Terminal</span>
              <button type="button" data-copy-command>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
                <span>Copy</span>
              </button>
            </div>
            <pre><code data-command-output>{initialPlan.command}</code></pre>
          </div>

          <div class="verification-row">
            <div>
              <span>Verify after deploy</span>
              <code data-verification-output>{initialPlan.verificationCommand}</code>
            </div>
            <a href="https://docs.openma.dev/self-host/overview/" target="_blank" rel="noopener noreferrer">
              Full guide
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
          </div>

          <p class="copy-feedback" data-copy-feedback role="status" aria-live="polite"></p>
        </div>

        <footer class="wizard-actions">
          <button type="button" class="secondary-button" data-back disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            Back
          </button>
          <span class="keyboard-hint"><kbd>←</kbd><kbd>→</kbd> to move</span>
          <button type="button" class="primary-button" data-next>
            Continue
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </footer>
      </section>

      <aside class="receipt-card" aria-label="Deployment summary">
        <div class="receipt-heading">
          <div>
            <span class="receipt-mark" aria-hidden="true"><span></span></span>
            <div><p>Deployment receipt</p><strong data-receipt-name>{initialPlan.name}</strong></div>
          </div>
          <span class="receipt-state" data-receipt-status>{initialPlan.status}</span>
        </div>

        <dl class="receipt-list">
          <div><dt>Topology</dt><dd data-receipt-topology>{initialPlan.topology}</dd></div>
          <div><dt>Persistence</dt><dd data-receipt-persistence>{initialPlan.persistence}</dd></div>
          <div><dt>Model setup</dt><dd data-receipt-model>{initialPlan.modelSetup}</dd></div>
          <div><dt>Estimated time</dt><dd data-receipt-estimate>{initialPlan.estimate}</dd></div>
        </dl>

        <div class="requirement-list">
          <p>Before you start</p>
          <ul data-requirements>
            {initialPlan.requirements.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
          </ul>
        </div>

        <div class="receipt-footer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.8 6.5 9.8 3.8-2 6.5-5.7 6.5-9.8V6L12 3Z"></path></svg>
          <p><strong>No hidden control plane.</strong><br />Resources land in the account you choose.</p>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import {
      buildDeploymentPlan,
      parseBrowserSelection,
      parseVercelDeploymentCallback,
      serializeBrowserSelection,
      type DataMode,
      type DeploymentTarget,
      type ModelSetup,
    } from "../lib/deploy-wizard";

    const root = document.querySelector<HTMLElement>("[data-deploy-wizard]");
    if (root) {
      let step = 1;
      let furthestStep = 1;
      let target: DeploymentTarget = "cloudflare";
      let modelSetup: ModelSetup = "console";
      let dataMode: DataMode = "managed";
      let vercelCallback = parseVercelDeploymentCallback(new URLSearchParams(window.location.search));
      const storageKey = "openma:deploy-wizard:v1";
      const stepStorageKey = `${storageKey}:step`;
      const stored = parseBrowserSelection(sessionStorage.getItem(storageKey));
      if (stored) {
        target = stored.target;
        modelSetup = stored.modelSetup;
        dataMode = stored.dataMode;
      }
      const storedStep = Number(sessionStorage.getItem(stepStorageKey));
      if (Number.isInteger(storedStep) && storedStep >= 1 && storedStep <= 3) {
        step = storedStep;
        furthestStep = storedStep;
      }
      if (vercelCallback) {
        target = "vercel";
        dataMode = "managed";
        step = 3;
        furthestStep = 3;
      }

      const get = <T extends Element>(selector: string) => root.querySelector<T>(selector);
      const getAll = <T extends Element>(selector: string) => [...root.querySelectorAll<T>(selector)];

      const replaceList = (list: HTMLUListElement | null, items: string[]) => {
        if (!list) return;
        list.replaceChildren(...items.map((item) => {
          const li = document.createElement("li");
          const check = document.createElement("span");
          check.setAttribute("aria-hidden", "true");
          check.textContent = "✓";
          li.append(check, item);
          return li;
        }));
      };

      const renderPlan = () => {
        const callbackUrl = new URL("/deploy/", window.location.origin);
        callbackUrl.searchParams.set("provider", "vercel");
        callbackUrl.searchParams.set("phase", "callback");
        const plan = buildDeploymentPlan(
          { target, modelSetup, dataMode },
          { vercelRedirectUrl: callbackUrl.toString() },
        );
        sessionStorage.setItem(storageKey, serializeBrowserSelection({ target, modelSetup, dataMode }));
        get<HTMLElement>("[data-receipt-name]")!.textContent = plan.name;
        get<HTMLElement>("[data-receipt-status]")!.textContent = plan.status;
        get<HTMLElement>("[data-receipt-topology]")!.textContent = plan.topology;
        get<HTMLElement>("[data-receipt-persistence]")!.textContent = plan.persistence;
        get<HTMLElement>("[data-receipt-model]")!.textContent = plan.modelSetup;
        get<HTMLElement>("[data-receipt-estimate]")!.textContent = plan.estimate;
        get<HTMLElement>("[data-launch-status]")!.textContent = plan.status;
        get<HTMLElement>("[data-command-output]")!.textContent = plan.command;
        get<HTMLElement>("[data-verification-output]")!.textContent = plan.verificationCommand;
        replaceList(get<HTMLUListElement>("[data-requirements]"), plan.requirements);

        const providerLaunch = get<HTMLElement>("[data-provider-launch]");
        const deployLink = get<HTMLAnchorElement>("[data-vercel-deploy]");
        if (providerLaunch) providerLaunch.hidden = target !== "vercel" || Boolean(vercelCallback);
        if (deployLink && plan.launchUrl) deployLink.href = plan.launchUrl;

        const callbackPanel = get<HTMLElement>("[data-vercel-callback]");
        if (callbackPanel) callbackPanel.hidden = target !== "vercel" || !vercelCallback;
        if (vercelCallback) {
          const projectName = get<HTMLElement>("[data-vercel-project-name]");
          const deploymentLink = get<HTMLAnchorElement>("[data-vercel-deployment-link]");
          const dashboardLink = get<HTMLAnchorElement>("[data-vercel-dashboard-link]");
          if (projectName) projectName.textContent = `${vercelCallback.projectName} is deployed`;
          if (deploymentLink) deploymentLink.href = vercelCallback.deploymentUrl;
          if (dashboardLink) {
            dashboardLink.hidden = !vercelCallback.projectDashboardUrl;
            if (vercelCallback.projectDashboardUrl) dashboardLink.href = vercelCallback.projectDashboardUrl;
          }
        }

        const commandLabel = get<HTMLElement>("[data-command-label]");
        if (commandLabel) commandLabel.textContent = target === "vercel" ? "CLI fallback" : "Terminal";

        const description = get<HTMLElement>("[data-launch-description]");
        if (description) {
          description.textContent = target === "vercel"
            ? "The packaged Function handles API traffic, signed webhook wakeups, and bounded fallback polls; the agent loop runs inside Vercel Sandbox."
            : target === "fly"
              ? "The Fly adapter keeps one Machine awake, mounts durable state, derives its public origin, and starts the portable Node control plane."
              : "Run this locally. Authentication and generated secrets stay between your terminal and the provider.";
        }

        const dataSection = get<HTMLElement>("[data-data-mode-section]");
        const boundary = get<HTMLElement>("[data-platform-boundary]");
        const usesNodeState = target === "docker" || target === "fly";
        if (dataSection) dataSection.hidden = !usesNodeState;
        if (boundary) {
          boundary.hidden = usesNodeState;
          const title = boundary.querySelector("strong");
          const body = boundary.querySelector("p");
          if (title && body) {
            if (target === "vercel") {
              title.textContent = "Packaged beta boundary";
              body.textContent = "External Postgres and object storage are durable. The Function is bounded; claimed Work, ACP steering, and the long-running harness loop stay inside Vercel Sandbox.";
            } else {
              title.textContent = "Provider-managed state";
              body.textContent = "Cloudflare provisions D1, R2, KV, Queue, Durable Objects, and Containers in your account.";
            }
          }
        }
      };

      const renderStep = () => {
        sessionStorage.setItem(stepStorageKey, String(step));
        for (const panel of getAll<HTMLElement>("[data-step-panel]")) {
          panel.hidden = Number(panel.dataset.stepPanel) !== step;
        }
        for (const button of getAll<HTMLButtonElement>("[data-step-jump]")) {
          const buttonStep = Number(button.dataset.stepJump);
          button.disabled = buttonStep > furthestStep;
          button.classList.toggle("is-active", buttonStep === step);
          button.classList.toggle("is-complete", buttonStep < step);
          if (buttonStep === step) button.setAttribute("aria-current", "step");
          else button.removeAttribute("aria-current");
        }
        const back = get<HTMLButtonElement>("[data-back]");
        const next = get<HTMLButtonElement>("[data-next]");
        if (back) back.disabled = step === 1;
        if (next) {
          if (step === 3) {
            next.textContent = "Start over";
          } else {
            next.replaceChildren("Continue");
            const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
            icon.setAttribute("viewBox", "0 0 24 24");
            icon.setAttribute("aria-hidden", "true");
            icon.innerHTML = '<path d="m9 18 6-6-6-6"></path>';
            next.append(icon);
          }
        }
        renderPlan();
      };

      for (const radio of getAll<HTMLInputElement>('input[name="deployment-target"]')) {
        radio.checked = radio.value === target;
        radio.closest<HTMLElement>("[data-target-card]")?.classList.toggle("is-selected", radio.checked);
        radio.addEventListener("change", () => {
          target = radio.value as DeploymentTarget;
          if (target !== "vercel") vercelCallback = null;
          dataMode = target === "cloudflare" || target === "vercel" ? "managed" : "sqlite";
          for (const card of getAll<HTMLElement>("[data-target-card]")) {
            card.classList.toggle("is-selected", card.dataset.targetCard === target);
          }
          renderPlan();
        });
      }

      for (const radio of getAll<HTMLInputElement>('input[name="model-setup"]')) {
        radio.checked = radio.value === modelSetup;
        radio.closest<HTMLElement>("[data-choice-row]")?.classList.toggle("is-selected", radio.checked);
        radio.addEventListener("change", () => {
          modelSetup = radio.value as ModelSetup;
          for (const row of getAll<HTMLElement>("[data-choice-row]")) {
            row.classList.toggle("is-selected", row.contains(radio));
          }
          renderPlan();
        });
      }

      for (const radio of getAll<HTMLInputElement>('input[name="data-mode"]')) {
        radio.checked = radio.value === dataMode || (dataMode === "managed" && radio.value === "sqlite");
        radio.closest<HTMLElement>("[data-segment]")?.classList.toggle("is-selected", radio.checked);
        radio.addEventListener("change", () => {
          dataMode = radio.value as DataMode;
          for (const segment of getAll<HTMLElement>("[data-segment]")) {
            segment.classList.toggle("is-selected", segment.contains(radio));
          }
          const hint = get<HTMLElement>("[data-data-mode-hint]");
          if (hint) hint.textContent = dataMode === "postgres"
            ? "Recommended for multiple API replicas or a managed database boundary."
            : "Best for one durable host. The data directory must be persistent.";
          renderPlan();
        });
      }

      get<HTMLButtonElement>("[data-next]")?.addEventListener("click", () => {
        if (step === 3) vercelCallback = null;
        step = step === 3 ? 1 : step + 1;
        furthestStep = Math.max(furthestStep, step);
        renderStep();
      });
      get<HTMLButtonElement>("[data-back]")?.addEventListener("click", () => {
        step = Math.max(1, step - 1);
        renderStep();
      });
      for (const button of getAll<HTMLButtonElement>("[data-step-jump]")) {
        button.addEventListener("click", () => {
          const nextStep = Number(button.dataset.stepJump);
          if (nextStep <= furthestStep) {
            step = nextStep;
            renderStep();
          }
        });
      }

      root.addEventListener("keydown", (event) => {
        if (event.target instanceof HTMLInputElement) return;
        if (event.key === "ArrowLeft" && step > 1) {
          step -= 1;
          renderStep();
        }
        if (event.key === "ArrowRight" && step < furthestStep) {
          step += 1;
          renderStep();
        }
      });

      get<HTMLButtonElement>("[data-copy-command]")?.addEventListener("click", async () => {
        const command = get<HTMLElement>("[data-command-output]")?.textContent ?? "";
        const feedback = get<HTMLElement>("[data-copy-feedback]");
        try {
          await navigator.clipboard.writeText(command);
          if (feedback) feedback.textContent = "Command copied to clipboard.";
          const label = get<HTMLElement>("[data-copy-command] span");
          if (label) label.textContent = "Copied";
          window.setTimeout(() => {
            if (label) label.textContent = "Copy";
            if (feedback) feedback.textContent = "";
          }, 1800);
        } catch {
          if (feedback) feedback.textContent = "Clipboard access was blocked. Select and copy the command manually.";
        }
      });

      renderStep();
      if (vercelCallback) {
        window.history.replaceState({}, "", window.location.pathname);
      }
    }
  </script>
</Base>

<style>
  .deploy-page {
    --wizard-radius: 12px;
    --wizard-row: 2.25rem;
    --wizard-control: 2rem;
    --wizard-pad: clamp(1rem, 2.4vw, 1.5rem);
    --wizard-shadow: 0 1px 0 rgb(0 0 0 / 3%), 0 18px 52px -34px rgb(0 0 0 / 24%);
    min-height: calc(100vh - 4rem);
    padding: clamp(2.5rem, 6vw, 5.5rem) 1rem 5rem;
    background:
      radial-gradient(circle at 20% 0%, color-mix(in srgb, var(--color-brand-subtle) 42%, transparent), transparent 27rem),
      var(--color-bg-sidebar);
  }

  .deploy-intro,
  .step-track,
  .wizard-shell {
    width: min(70rem, 100%);
    margin-inline: auto;
  }

  .deploy-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .deploy-kicker,
  .panel-eyebrow {
    margin: 0 0 .45rem;
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .deploy-intro h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1;
    letter-spacing: -.035em;
  }

  .deploy-lede {
    max-width: 39rem;
    margin: .85rem 0 0;
    color: var(--color-fg-muted);
    font-size: .95rem;
    line-height: 1.55;
  }

  .privacy-note {
    display: flex;
    align-items: center;
    gap: .65rem;
    max-width: 22rem;
    padding: .75rem .85rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 8px;
