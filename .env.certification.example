# Copy to .env.certification.local. The live certification runner loads that
# file automatically; never commit the local file or real credential values.

BL_API_KEY=

# Optional locally: the Cloudflare lane also accepts an authenticated Wrangler
# OAuth profile (`pnpm exec wrangler login`). CI should set both values instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Production checkpoint/restore lane. Set OMA_CLOUDFLARE_R2_BUCKET to reuse a
# dedicated bucket with a bucket-scoped Object Read & Write token. If omitted,
# the runner creates and removes a uniquely named bucket and therefore needs
# broader bucket-management permission through Wrangler.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OMA_CLOUDFLARE_R2_BUCKET=
OMA_CLOUDFLARE_BRIDGE_URL=
OMA_CLOUDFLARE_BRIDGE_API_KEY=
OMA_CLOUDFLARE_BRIDGE_RUNTIME_ID=

DAYTONA_API_KEY=
E2B_API_KEY=

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
SPRITES_TOKEN=
SUPERSERVE_API_KEY=

VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Non-secret endpoint used by the BoxRun live lane.
BOXRUN_URL=
